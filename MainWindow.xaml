<Window x:Class="PinyinSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pinyin Switcher"
        Height="360"
        Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="1" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="当前输入模式" />
        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
            <RadioButton x:Name="FullPinyinRadioButton"
                         GroupName="PinyinMode"
                         Content="全拼"
                         Margin="0,0,32,0" />
            <RadioButton x:Name="DoublePinyinRadioButton"
                         GroupName="PinyinMode"
                         Content="双拼" />
            <TextBlock x:Name="CurrentModeTextBlock"
                       Margin="24,0,0,0"
                       Foreground="Gray"
                       Text="正在检测…" />
        </StackPanel>

        <Border Grid.Row="3" Background="#FFE0E0E0" />

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock FontWeight="SemiBold" Text="快捷键" />
            <TextBlock Grid.Column="1" Text="Ctrl + Alt + P" />
        </Grid>

        <CheckBox x:Name="StartWithWindowsCheckBox"
                  Grid.Row="6"
                  Margin="0,14,0,0"
                  Content="开机自动启动" />
        <CheckBox x:Name="ShowNotificationCheckBox"
                  Grid.Row="7"
                  Margin="0,10,0,0"
                  Content="切换后显示通知" />
        <CheckBox x:Name="StartMinimizedCheckBox"
                  Grid.Row="8"
                  Margin="0,10,0,0"
                  Content="软件启动后最小化到托盘" />

        <StackPanel Grid.Row="10" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="84" Margin="0,0,10,0" Content="取消" Click="CancelButton_Click" />
            <Button Width="84" IsDefault="True" Content="保存" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
